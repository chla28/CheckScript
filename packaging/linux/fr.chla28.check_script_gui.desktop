[Desktop Entry]
Type=Application
Name=CheckScript
GenericName=Évaluation de scripts shell et Python
GenericName[en]=Shell and Python script assessment
Comment=Évalue la sécurité, la robustesse et la maintenabilité de scripts shell et Python
Comment[en]=Rates the security, robustness and maintainability of shell and Python scripts
Exec=check-script-gui %F
Icon=fr.chla28.check_script_gui
Categories=Development;
Keywords=shell;bash;python;script;shellcheck;ruff;lint;security;
MimeType=application/x-shellscript;text/x-shellscript;text/x-python;text/x-python3;
Terminal=false
StartupNotify=true
StartupWMClass=check_script_gui
