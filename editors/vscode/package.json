{
  "name": "check-script",
  "displayName": "CheckScript",
  "description": "%description%",
  "version": "0.19.2",
  "publisher": "chla28",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/chla28/CheckScript"
  },
  "icon": "images/check_script.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "shell",
    "bash",
    "python",
    "shellcheck",
    "ruff",
    "security"
  ],
  "activationEvents": [
    "onLanguage:shellscript",
    "onLanguage:python",
    "onLanguage:dockerfile",
    "onLanguage:makefile",
    "onLanguage:yaml",
    "onLanguage:ansible",
    "onLanguage:github-actions-workflow"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "checkScript.analyze",
        "title": "%command.analyze.title%",
        "category": "CheckScript"
      },
      {
        "command": "checkScript.restart",
        "title": "%command.restart.title%",
        "category": "CheckScript"
      }
    ],
    "configuration": {
      "title": "CheckScript",
      "properties": {
        "checkScript.path": {
          "type": "string",
          "default": "check-script",
          "description": "%config.path%"
        },
        "checkScript.lang": {
          "type": "string",
          "enum": [
            "",
            "fr",
            "en"
          ],
          "enumDescriptions": [
            "%config.lang.auto%",
            "Français",
            "English"
          ],
          "default": "",
          "description": "%config.lang%"
        },
        "checkScript.profile": {
          "type": "string",
          "enum": [
            "",
            "strict",
            "default",
            "legacy"
          ],
          "default": "",
          "description": "%config.profile%"
        },
        "checkScript.analyzeOnType": {
          "type": "boolean",
          "default": true,
          "description": "%config.analyzeOnType%"
        },
        "checkScript.typingDelay": {
          "type": "number",
          "default": 600,
          "minimum": 100,
          "description": "%config.typingDelay%"
        },
        "checkScript.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "%config.trace%"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify",
    "check": "tsc --noEmit",
    "package": "cp ../../LICENSE LICENSE && npm run check && npm run build && vsce package --no-dependencies --out check-script.vsix",
    "build-tests": "esbuild test/runTest.ts test/suite.ts --bundle --outdir=out/test --external:vscode --external:@vscode/test-electron --format=cjs --platform=node --target=node20",
    "test": "npm run build && npm run build-tests && node out/test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "@vscode/test-electron": "^3.1.0"
  }
}
